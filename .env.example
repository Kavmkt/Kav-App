# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kavapp?schema=public"

# Segredo usado para assinar os cookies de sessão (gere um valor aleatório forte em produção)
# Ex: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# --- Integração Meta (Instagram Graph API / Marketing API) ---
# Preencha estes valores quando tiver um app criado em https://developers.facebook.com
# Enquanto vazios, o app funciona normalmente usando dados de demonstração.
META_APP_ID=""
META_APP_SECRET=""
# Token de acesso de sistema (system user) de longa duração com permissões
# instagram_basic, instagram_manage_insights, ads_read
META_SYSTEM_ACCESS_TOKEN=""
