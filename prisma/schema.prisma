generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  SALES
}

enum PostType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
}

model User {
  id                 String   @id @default(cuid())
  /// Identificador de login — o app autentica por usuário+senha, não por
  /// e-mail. Sempre gravado normalizado (minúsculas, sem acento/espaço)
  /// via normalizeUsername() em src/lib/utils.ts.
  username           String   @unique
  /// Só um dado de contato agora (opcional pra próximos cadastros, mas
  /// segue obrigatório no schema pra não quebrar linhas antigas) — não é
  /// mais usado pra login.
  email              String   @unique
  passwordHash       String
  name               String
  role               Role     @default(CLIENT)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress[]

  @@index([clientId])
}

model Client {
  id               String   @id @default(cuid())
  companyName      String
  slug             String   @unique
  contactEmail     String?
  instagramHandle  String?
  instagramUserId  String?
  metaAdAccountId  String?
  metaAccessToken  String?
  logoColor        String   @default("#6366f1")
  /// URL de uma imagem do logotipo do cliente, exibida no lugar do avatar de
  /// iniciais no painel dele. Opcional — configurado pelo admin.
  logoUrl          String?
  plan             String   @default("Essencial")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  metricSnapshots MetricSnapshot[]
  posts           Post[]
  campaigns       AdCampaign[]
  adSnapshots     AdSpendSnapshot[]
}

model MetricSnapshot {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date              DateTime
  followers         Int
  following         Int
  postsCount        Int
  avgEngagementRate Float
  profileViews      Int
  reach             Int
  /// true = gerado pelo seed/simulação de demonstração; false = veio da Meta Graph API de verdade.
  /// Usado para nunca misturar os dois numa mesma série/gráfico (veja src/lib/data/queries.ts).
  isDemo            Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model Post {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// ID da mídia na Meta Graph API (para não duplicar em sincronizações repetidas). Nulo para posts de demonstração.
  externalId  String?   @unique
  platform    String    @default("INSTAGRAM")
  type        PostType  @default(IMAGE)
  caption     String?
  mediaUrl    String?
  /// Miniatura própria pra vídeos/Reels (media_url de vídeo aponta pro
  /// arquivo, não serve como preview de imagem). Nula pra fotos/carrossel,
  /// onde mediaUrl já é uma imagem.
  thumbnailUrl String?
  permalink   String?
  likes       Int       @default(0)
  comments    Int       @default(0)
  shares      Int       @default(0)
  saves       Int       @default(0)
  reach       Int       @default(0)
  impressions Int       @default(0)
  postedAt    DateTime
  createdAt   DateTime  @default(now())
  /// true = post de demonstração; false = sincronizado de verdade do Instagram.
  isDemo      Boolean   @default(true)

  @@index([clientId, postedAt])
}

model AdCampaign {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  objective   CampaignObjective @default(TRAFFIC)
  status      CampaignStatus    @default(ACTIVE)
  dailyBudget Float
  spend       Float             @default(0)
  impressions Int               @default(0)
  clicks      Int               @default(0)
  results     Int               @default(0)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId])
}

model AdSpendSnapshot {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  spend       Float
  impressions Int
  clicks      Int
  conversions Int
  /// true = gerado por simulação de demonstração; false = veio da Marketing API de verdade.
  isDemo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  coverColor  String   @default("#6366f1")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]
}

model Module {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  lessons Lesson[]
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  content         String
  videoUrl        String?
  durationMinutes Int      @default(10)
  order           Int      @default(0)

  progress LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}
