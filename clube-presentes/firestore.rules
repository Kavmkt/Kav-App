rules_version = '2';

// Regras de referência para o Clube de Presentes (MVP).
// Cole em Firebase Console > Firestore Database > Regras (ou faça deploy
// via Firebase CLI: `firebase deploy --only firestore:rules`).
//
// Modelo do MVP: não existe autocadastro nem admin panel — a gestora da
// Lily Cestas cria usuários (Authentication) e os documentos de
// packages/items/subscriptions diretamente pelo Console. Por isso essas
// coleções são somente leitura para o cliente autenticado; só `selections`
// aceita escrita, e apenas do próprio dono do documento.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // gerido manualmente pela gestora
    }

    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // gerido manualmente pela gestora
    }

    match /selections/{selectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
