# Configuração do projeto Firebase (Project settings > Your apps > SDK setup and configuration)
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# Todas as variáveis precisam do prefixo VITE_ para ficarem disponíveis no
# código do cliente (import.meta.env), conforme exigido pelo Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
